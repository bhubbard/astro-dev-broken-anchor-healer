{
  "name": "astro-dev-broken-anchor-healer",
  "version": "1.0.0",
  "description": "Astro Dev Toolbar app that scans for broken internal anchor links and uses Chrome Built-in AI (Gemini Nano) to semantically heal and recommend valid targets",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js",
      "default": "./dist/app.js"
    },
    "./scanner": {
      "types": "./dist/scanner.d.ts",
      "import": "./dist/scanner.js",
      "default": "./dist/scanner.js"
    },
    "./matcher": {
      "types": "./dist/matcher.d.ts",
      "import": "./dist/matcher.js",
      "default": "./dist/matcher.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/index.ts --target node --outdir ./dist && bun build src/app.ts src/scanner.ts src/matcher.ts --target browser --outdir ./dist && bun x tsc -p tsconfig.build.json",
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit"
  },
  "keywords": [
    "astro",
    "astro-integration",
    "astro-dev-toolbar",
    "dev-toolbar",
    "gemini-nano",
    "chrome-ai",
    "window.ai",
    "broken-links",
    "anchor-links",
    "semantic-matcher"
  ],
  "author": "bhubbard",
  "license": "MIT",
  "peerDependencies": {
    "astro": ">=5.0.0 <8.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "astro": "^5.4.0",
    "typescript": "^5.8.0"
  }
}
